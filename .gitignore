# nix build result
/result

# direnv cache (nix-direnv가 devShell 평가 결과 캐싱)
.direnv/

# 임시/백업 파일 범용 안전망 (도입 근거였던 update-codex의 .bak 백업은
# .codex-pin.* 임시파일로 교체됨 — 현재 저장소 내 고정 생성 주체 없음)
*.bak

# Codex CLI
.agents/skills/wt-plugin--*
.codex/

# update-codex 원자적 핀 교체용 임시 파일 (EXIT trap 정리; SIGKILL 시 잔류 방어, #890)
modules/shared/programs/codex/.codex-pin.*

# 퇴역한 codex-sync 시절 부산물 방어 (#41 도입, 현재 산출 주체 없음 — 현행 투영은
# .agents/skills/<name> → .claude/skills/<name> 심링크라 .claude/skills/ 안에 아무것도
# 쓰지 않는다. 다른 도구가 같은 잔재를 만들 경우의 커밋 차단용으로만 잔존)
.claude/skills/*/agents/
.claude/skills/*/references/references

# .claude/plans/ — 글로벌 gitignore(~/.config/git/ignore)가 **/.claude/plans 디렉토리를 차단.
# 디렉토리 정책 문서 README.md만 tracked로 유지하고 (이슈 #756 P0) 다른 plan 파일
# (transient buffer + SSOT plan)은 그대로 untracked 유지.
!.claude/plans
.claude/plans/*
!.claude/plans/README.md

# 브라우저 자동화 storage state (평문 세션 토큰 포함 — playwright-cli state-save 산출물)
storage-state-*.json

# playwright-cli 런타임 산출물 (스냅샷, 세션 데이터)
.playwright-cli/

# 로컬 전용 메모 (시크릿 포함 가능 — 추적 금지. gitleaks 스캔 예외는 두지 않는다)
*.local.md

# Python 바이트코드 캐시 (스크립트/테스트 실행 부산물)
__pycache__/
